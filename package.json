{
  "name": "tapajiro",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.1",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @tapajiro/web dev",
    "build": "pnpm --filter @tapajiro/web build",
    "preview": "pnpm --filter @tapajiro/web preview",
    "lint": "eslint packages/ apps/ scripts/ --max-warnings=0",
    "lint:fix": "eslint packages/ apps/ scripts/ --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:screenshots": "pnpm exec tsx scripts/screenshot.mts",
    "test:architecture": "pnpm exec tsx scripts/test-architecture.mts",
    "test:design-tokens": "pnpm exec tsx scripts/test-design-tokens.mts",
    "test:icons": "pnpm exec tsx scripts/test-icons.mts",
    "test:pwa-cache": "pnpm --filter @tapajiro/web build && pnpm exec tsx scripts/test-pwa-cache.mts",
    "test:adrs": "pnpm exec tsx scripts/test-adrs.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:architecture && pnpm test:design-tokens && pnpm test:icons && pnpm test:pwa-cache && pnpm test:adrs && pnpm test && pnpm test:coverage && pnpm test:e2e",
    "supabase:start": "pnpm exec supabase start",
    "supabase:status": "pnpm exec supabase status",
    "supabase:stop": "pnpm exec supabase stop",
    "test:db": "pnpm exec supabase test db"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "9",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.5",
    "sharp": "^0.34.2",
    "supabase": "2.109.1",
    "tsx": "^4.23.1",
    "typescript": "5",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
